{
  "name": "@ptools/host-api",
  "version": "0.1.0-alpha.0",
  "license": "MIT",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Ruchir28/ptools.git",
    "directory": "packages/host-api"
  },
  "homepage": "https://github.com/Ruchir28/ptools#readme",
  "bugs": {
    "url": "https://github.com/Ruchir28/ptools/issues"
  },
  "files": [
    "dist/*.js",
    "dist/*.js.map",
    "dist/*.d.ts",
    "dist/*.d.ts.map",
    "dist/contracts/*.js",
    "dist/contracts/*.js.map",
    "dist/contracts/*.d.ts",
    "dist/contracts/*.d.ts.map",
    "dist/services/*.js",
    "dist/services/*.js.map",
    "dist/services/*.d.ts",
    "dist/services/*.d.ts.map",
    "dist/http/**/*.js",
    "dist/http/**/*.js.map",
    "dist/http/**/*.d.ts",
    "dist/http/**/*.d.ts.map",
    "README.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./contracts": {
      "types": "./dist/contracts/index.d.ts",
      "default": "./dist/contracts/index.js"
    },
    "./effect": {
      "types": "./dist/services/index.d.ts",
      "default": "./dist/services/index.js"
    },
    "./http": {
      "types": "./dist/http/index.d.ts",
      "default": "./dist/http/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.test.json --noEmit",
    "test": "vitest run --dir test"
  },
  "dependencies": {
    "@ptools/auth": "workspace:*",
    "@ptools/code-mode-api": "workspace:*",
    "@ptools/config": "workspace:*",
    "effect": "4.0.0-beta.102"
  }
}
