{
  "name": "@ptools/host-node",
  "version": "0.1.0-alpha.0",
  "license": "MIT",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Ruchir28/ptools.git",
    "directory": "packages/host-node"
  },
  "homepage": "https://github.com/Ruchir28/ptools#readme",
  "bugs": {
    "url": "https://github.com/Ruchir28/ptools/issues"
  },
  "files": [
    "dist/*.js",
    "dist/*.js.map",
    "dist/*.d.ts",
    "dist/*.d.ts.map",
    "dist/**/*.d.ts.map",
    "dist/**/*.js",
    "dist/**/*.js.map",
    "dist/**/*.d.ts",
    "drizzle/node-control-plane/**",
    "README.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./host-actor-daemon-entrypoint": {
      "types": "./dist/hostActorDaemon/daemonProcess/nodeHostActorDaemonEntrypoint.d.ts",
      "default": "./dist/hostActorDaemon/daemonProcess/nodeHostActorDaemonEntrypoint.js"
    },
    "./host-control-plane-daemon-entrypoint": {
      "types": "./dist/hostControlPlaneDaemon/daemonProcess/nodeHostControlPlaneDaemonEntrypoint.d.ts",
      "default": "./dist/hostControlPlaneDaemon/daemonProcess/nodeHostControlPlaneDaemonEntrypoint.js"
    }
  },
  "imports": {
    "#sandbox-worker": "./dist/executor/sandbox-worker.js"
  },
  "scripts": {
    "clean": "node -e \"const fs=require('node:fs'); fs.rmSync('dist', { recursive: true, force: true }); fs.rmSync('tsconfig.tsbuildinfo', { force: true })\"",
    "build": "pnpm clean && pnpm --filter @ptools/executor build && tsc -p tsconfig.json && pnpm build:worker",
    "build:worker": "node scripts/build-sandbox-worker.mjs",
    "typecheck": "tsc -p tsconfig.test.json --noEmit",
    "test": "pnpm --filter @ptools/executor build && pnpm build:worker && vitest run --exclude \"**/dist/**\""
  },
  "devDependencies": {
    "@types/node": "25.9.1",
    "drizzle-kit": "1.0.0-rc.4",
    "esbuild": "^0.27.0"
  },
  "dependencies": {
    "@effect/platform-node": "4.0.0-beta.102",
    "@effect/sql-sqlite-node": "4.0.0-beta.102",
    "@modelcontextprotocol/sdk": "1.29.0",
    "@napi-rs/keyring": "^1.3.0",
    "@ptools/auth": "workspace:*",
    "@ptools/code-mode-api": "workspace:*",
    "@ptools/config": "workspace:*",
    "@ptools/executor": "workspace:*",
    "@ptools/host-api": "workspace:*",
    "@ptools/host-authorization": "workspace:*",
    "@ptools/host-context": "workspace:*",
    "@ptools/host-runtime": "workspace:*",
    "@ptools/mcp-registry": "workspace:*",
    "drizzle-orm": "1.0.0-rc.4",
    "effect": "4.0.0-beta.102",
    "fs-native-extensions": "1.5.0"
  }
}
