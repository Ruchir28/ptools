{
  "mcpServers": {
    "ptools": {
      "type": "stdio",
      "command": "npx",
      "args": [
        "-y",
        "@ptools/cli",
        "mcp",
        "serve",
        "--host",
        "node",
        "--host-id",
        "example-mcp-hosts",
        "--config",
        ".ptools/config.json"
      ]
    }
  }
}
